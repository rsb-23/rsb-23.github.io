{
  "name": "open-projects",
  "version": "0.1.0",
  "description": "A Vue app for showcasing projects",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "deploy": "npm run build && gh-pages -d dist --cname projects.tchh.in",
    "ci:icons": "node scripts/fetch-favicons.js"
  },
  "dependencies": {
    "vue": "^3.5.26",
    "vue-router": ""
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-service": "~5.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^8.0.3",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.39",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "vue-template-compiler": "",
    "webpack-dev-server": "^5.2.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "vue/multi-word-component-names": "off"
    }
  }
}
